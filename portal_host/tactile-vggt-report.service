[Unit]
Description=Tactile VGGT research report portal and resources
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u %h/tactile-vggt-report-host/serve.py --bind __BIND__ --port __PORT__ --directory %h/tactile-vggt-report-host/current/public
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M
TasksMax=64
Nice=10

[Install]
WantedBy=default.target
